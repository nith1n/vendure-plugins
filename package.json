{
  "name": "vendure-plugins",
  "private": true,
  "description": "Vendure plugins by Valoriz. Each plugin lives in packages/, with its own dev server and tests.",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @nith1n/vendure-plugin-akeneo dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "5.8.2",
    "typescript-eslint": "8.72.1"
  }
}

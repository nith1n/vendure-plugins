{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "strictPropertyInitialization": false,
    "target": "es2019",
    "strict": true,
    "sourceMap": false,
    "skipLibCheck": true,
    "outDir": "./dev-server/dist",
    "baseUrl": "./"
  },
  "include": ["src/**/*.ts", "dev-server/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "dev-server/dist",
    "src/dashboard/*",
    "dev-server/gql/*",
    "dev-server/vite.*.*ts"
  ],
  "ts-node": {
    "files": true
  },
  "references": [
    {
      "path": "./tsconfig.dashboard.json"
    }
  ]
}

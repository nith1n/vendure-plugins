{
  "name": "@nith1n/vendure-plugin-akeneo",
  "version": "0.1.2",
  "description": "Sync categories, products, variants and images from Akeneo PIM to Vendure, with a dashboard to configure and run the sync.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nith1n/vendure-plugins.git",
    "directory": "packages/vendure-plugin-akeneo"
  },
  "homepage": "https://github.com/nith1n/vendure-plugins/tree/master/packages/vendure-plugin-akeneo#readme",
  "bugs": {
    "url": "https://github.com/nith1n/vendure-plugins/issues"
  },
  "keywords": [
    "vendure",
    "vendure-plugin",
    "akeneo",
    "pim",
    "product-sync"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vendure dev all --project . --server-entry ./dev-server/index.ts --worker-entry ./dev-server/index-worker.ts --vite-config ./dev-server/vite.config.mts",
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "migrate": "ts-node dev-server/migration.ts",
    "prepack": "node scripts/build.mjs",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/graphql": "^14.0.0",
    "@vendure/common": "^3.8.0",
    "@vendure/core": "^3.8.0",
    "@vendure/dashboard": "^3.8.0",
    "graphql-tag": "^2.12.6",
    "typeorm": "^0.3.21"
  },
  "peerDependenciesMeta": {
    "@vendure/dashboard": {
      "optional": true
    }
  }
}
